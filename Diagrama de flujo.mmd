flowchart LR

    %% ===================== Estilos =====================
    classDef ui        fill:#3b82f6,stroke:#1d4ed8,color:#ffffff,stroke-width:1.5px;
    classDef backend   fill:#a855f7,stroke:#7e22ce,color:#ffffff,stroke-width:1.5px;
    classDef db        fill:#22c55e,stroke:#15803d,color:#ffffff,stroke-width:1.5px;
    classDef auth      fill:#f97316,stroke:#c2410c,color:#ffffff,stroke-width:1.5px;
    classDef decision  fill:#f8fafc,stroke:#475569,color:#0f172a,stroke-width:1.5px;
    classDef jefe      fill:#eef2ff,stroke:#4f46e5,color:#1e1b4b,stroke-width:1.5px;
    classDef tecnico   fill:#ecfeff,stroke:#0891b2,color:#083344,stroke-width:1.5px;
    classDef usuario   fill:#f0fdf4,stroke:#16a34a,color:#052e16,stroke-width:1.5px;
    classDef estado    fill:#fef9c3,stroke:#ca8a04,color:#713f12,stroke-width:1.5px;

    %% ===================== Común · Autenticación =====================
    subgraph COMUN["Común · Autenticación (HU01, HU05)"]
        Inicio((Inicio)):::ui --> Ingresar["Ingresar correo y contraseña"]:::ui
        Ingresar --> DBloqueada{"¿Cuenta bloqueada?"}:::decision
        DBloqueada -- Sí --> MostrarBloqueo["Mostrar bloqueo + temporizador"]:::ui
        DBloqueada -- No --> Validar["Validar credenciales"]:::backend
        Validar --> DValida{"¿Credenciales válidas?"}:::decision
        DValida -- No --> Intento["Registrar intento fallido"]:::backend
        Intento --> DIntentos{"¿3 intentos?"}:::decision
        DIntentos -- Sí --> Bloquear[("Bloquear 15 min")]:::db
        Bloquear --> MostrarBloqueo
        DIntentos -- No --> Ingresar
        DValida -- Sí --> DCambio{"¿Debe cambiar contraseña?"}:::decision
        DCambio -- Sí --> NuevaPass["Cambiar contraseña obligatorio (HU05)"]:::backend
        DCambio -- No --> EmitirJWT["Emitir token JWT"]:::auth
        NuevaPass --> EmitirJWT
        EmitirJWT --> DRol{"¿Rol?"}:::decision
    end
    style COMUN fill:#fff7ed,stroke:#f97316,stroke-width:2px

    %% ===================== Jefe TI =====================
    subgraph JEFE["Jefe TI (HU02, HU03, HU04, HU09, HU12, HU13, HU14, HU18, HU20, HU21, HU22, HU23, HU24)"]
        PanelJefe(["Panel Jefe TI"]):::jefe

        RegUsuario["Registrar usuario + rol (HU02)"]:::jefe
        ConsUsuarios["Consultar usuarios (HU03)"]:::jefe
        Perfil["Actualizar perfil (HU04)"]:::jefe

        RegSLA["Registrar prioridad SLA (HU09)"]:::jefe
        DSLA{"¿SLA configurado?"}:::decision
        SLAConfig["Prioridad aplicada a tickets"]:::estado

        RegEquipo["Registrar equipo (HU12)"]:::jefe
        ConsEquipos["Consultar equipos (HU13)"]:::jefe
        EditEquipo["Actualizar ficha de equipo (HU14)"]:::jefe

        Auditar["Auditar estado final del ticket (HU18)"]:::jefe

        RepSLA["Reporte de cumplimiento SLA (HU20)"]:::jefe
        DCumple{"¿Cumple respuesta y resolución?"}:::decision
        SLAOK["SLA cumplido"]:::estado
        Escalar["Escalar ticket / ajustar prioridad"]:::jefe

        RepCarga["Reporte de carga de trabajo de técnicos (HU21)"]:::jefe
        DBalance{"¿Carga balanceada?"}:::decision
        CargaOK["Carga balanceada"]:::estado
        Reasignar["Reasignar tickets"]:::jefe

        RepFallas["Reporte de fallas por equipo (HU22)"]:::jefe
        DFallas{"¿Equipo con fallas recurrentes?"}:::decision
        FallasOK["Sin fallas recurrentes"]:::estado
        Mantenimiento["Programar mantenimiento"]:::jefe

        RepSatisf["Reporte de evaluaciones de satisfacción (HU23)"]:::jefe
        RepArticulos["Reporte de artículos más consultados (HU24)"]:::jefe

        PanelJefe --> RegUsuario
        PanelJefe --> ConsUsuarios
        PanelJefe --> Perfil
        PanelJefe --> RegSLA --> DSLA
        DSLA -- Sí --> SLAConfig
        DSLA -- No --> RegSLA
        PanelJefe --> RegEquipo
        PanelJefe --> ConsEquipos
        PanelJefe --> EditEquipo
        PanelJefe --> Auditar
        PanelJefe --> RepSLA --> DCumple
        DCumple -- Sí --> SLAOK
        DCumple -- No --> Escalar --> SLAOK
        PanelJefe --> RepCarga --> DBalance
        DBalance -- Sí --> CargaOK
        DBalance -- No --> Reasignar --> CargaOK
        PanelJefe --> RepFallas --> DFallas
        DFallas -- Sí --> Mantenimiento
        DFallas -- No --> FallasOK
        PanelJefe --> RepSatisf
        PanelJefe --> RepArticulos
    end
    style JEFE fill:#f5f7ff,stroke:#4f46e5,stroke-width:2px

    %% ===================== Técnico =====================
    subgraph TECNICO["Técnico (HU07, HU08, HU10, HU15, HU16)"]
        PanelTec(["Panel Técnico"]):::tecnico

        ConsTickets["Consultar tickets (HU07)"]:::tecnico
        DTomado{"¿Ya tomado por otro técnico?"}:::decision
        Tomar["Iniciar soporte → En progreso (HU08)"]:::tecnico
        DTrans{"¿Transición permitida?"}:::decision
        Culminar["Culminar reporte → Cerrado (HU08)"]:::tecnico

        RegDisp["Registrar disponibilidad / turno (HU15)"]:::tecnico
        ConsDisp["Consultar disponibilidad (HU16)"]:::tecnico
        RegArticulo["Registrar artículo de conocimiento (HU10)"]:::tecnico

        PanelTec --> ConsTickets --> DTomado
        DTomado -- No --> Tomar --> DTrans
        DTomado -- Sí --> ConsTickets
        DTrans -- No --> ConsTickets
        DTrans -- Sí --> Culminar
        PanelTec --> RegDisp
        PanelTec --> ConsDisp
        PanelTec --> RegArticulo
    end
    style TECNICO fill:#ecfeff,stroke:#0891b2,stroke-width:2px

    %% ===================== Usuario =====================
    subgraph USUARIO["Usuario (HU06, HU07, HU08, HU11, HU17, HU19)"]
        PanelUser(["Panel Usuario"]):::usuario

        CrearTicket["Registrar ticket de incidencia (HU06)"]:::usuario
        ConsTicketsU["Consultar tickets (HU07)"]:::usuario
        DEsSuyo{"¿Es su ticket?"}:::decision
        Cancelar["Cancelar ticket (HU08)"]:::usuario

        ConsBase["Consultar base de conocimientos (HU11)"]:::usuario

        DCerrado{"¿Ticket cerrado sin evaluar?"}:::decision
        Evaluar["Registrar evaluación 1–5 (HU17)"]:::usuario
        ConsEval["Consultar evaluaciones (HU19)"]:::usuario

        PanelUser --> CrearTicket
        PanelUser --> ConsTicketsU --> DEsSuyo
        DEsSuyo -- Sí --> Cancelar
        DEsSuyo -- No --> ConsTicketsU
        PanelUser --> ConsBase
        PanelUser --> ConsEval
        DCerrado -- Sí --> Evaluar
        DCerrado -- No --> ConsEval
    end
    style USUARIO fill:#f0fdf4,stroke:#16a34a,stroke-width:2px

    %% ===================== Ciclo de vida del ticket =====================
    subgraph CICLO["Ciclo de vida del ticket (HU06, HU07, HU08, HU17, HU18)"]
        Abierto(["Abierto"]):::estado
        EnProgreso(["En progreso"]):::estado
        Cerrado(["Cerrado"]):::estado
        Cancelado(["Cancelado"]):::estado
        Abierto --> EnProgreso
        EnProgreso --> Cerrado
        Abierto --> Cancelado
    end
    style CICLO fill:#fefce8,stroke:#ca8a04,stroke-width:2px

    %% ===================== Conexiones entre carriles =====================
    DRol -- "Jefe TI" --> PanelJefe
    DRol -- "Técnico" --> PanelTec
    DRol -- "Usuario" --> PanelUser

    CrearTicket --> Abierto
    Abierto --> DTomado
    Tomar --> EnProgreso
    Culminar --> Cerrado
    Cancelar --> Cancelado

    Cerrado --> DCerrado
    Evaluar --> Cerrado

    Cerrado --> Auditar
    Cancelado --> Auditar

    Cerrado --> RepSLA
    Evaluar --> RepSatisf
    ConsEval --> RepSatisf
    RegArticulo --> RepArticulos
    ConsBase --> RepArticulos
    RegDisp --> RepCarga
